# Copy to /srv/videoflix/.env on the server and restrict it: chmod 600 .env
# Required values have no default; secrets never get an example value.

# --- Images (optional overrides; the pinned digests live in compose.yaml) ---
# BACKEND_IMAGE=ghcr.io/philippklinger/videoflix-backend@sha256:...
# FRONTEND_IMAGE=ghcr.io/philippklinger/videoflix-frontend@sha256:...

# --- Django ---
DEBUG=False
# Required, secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALLOWED_HOSTS=videoflix.philipp-klinger.com
# Frontend and API share one domain (no CORS, cookies SameSite=Strict)
CSRF_TRUSTED_ORIGINS=https://videoflix.philipp-klinger.com
FRONTEND_URL=https://videoflix.philipp-klinger.com
# Exactly one reverse proxy (Caddy) in front of Django
TRUSTED_PROXY_COUNT=1
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
RUN_MAKEMIGRATIONS=0

# --- Database (used by Django and to initialise Postgres) ---
DB_NAME=videoflix
DB_USER=videoflix
# Required, secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# --- Redis (cache, rate limits, job queue) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_LOCATION=redis://redis:6379/1

# --- Mail (All-Inkl SMTP) ---
# Required: SMTP host of the All-Inkl account, e.g. wXXXXXXX.kasserver.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Required: mailbox login
EMAIL_HOST_USER=
# Required, secret
EMAIL_HOST_PASSWORD=
# Required: sender address of that mailbox
DEFAULT_FROM_EMAIL=

# --- Gunicorn (optional, defaults shown) ---
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=120

# Throttle rates keep their strict defaults in production; do not set THROTTLE_RATE_* here.
